__pycache__/
site/
added.txt

# The add-ons' build, and the components addons/build.sh puts beside
# each manifest. A release builds them again. `niles plugin dev` keeps an
# add-on's storage in .niles-dev and reads its settings, which may hold
# a key, from dev-settings.toml.
/addons/target
/addons/*/integration.wasm
/addons/*/.niles-dev
/addons/*/dev-settings.toml

# bambulab's fake printer builds on its own, outside the workspace, and
# keeps its certificate and key in .fake-printer where it is started.
/addons/bambulab/fake-printer/target
.fake-printer/

# A Niles built for `niles plugin check`, outside a Niles checkout.
/.niles-target
